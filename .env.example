ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides.
TUTOR_MODEL=claude-sonnet-5-5
TUTOR_EFFORT=medium
# DATA_DIR=<tutor>/data (the default)

# Voice. site.toml chooses who speaks (voice = "kokoro" or "elevenlabs"); TUTOR_VOICE overrides it.
# An ElevenLabs key is used only when the voice is "elevenlabs".
VOICE_ENABLED=1
# TUTOR_VOICE=kokoro
# ELEVENLABS_API_KEY=
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=0.9
# WHISPER_MODEL=base.en
